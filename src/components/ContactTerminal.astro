---
---
<div class="relative group p-4 w-full max-w-2xl mx-auto">
    <div class="absolute inset-4 translate-y-3 translate-x-2 bg-[#38000A]/10 rounded-[2.5rem] -z-10 group-hover:translate-y-5 group-hover:translate-x-4 transition-all duration-500"></div>
    
    <div class="relative bg-white/40 backdrop-blur-2xl border border-white/60 rounded-[2.5rem] p-10 z-10 overflow-hidden">
        <div class="flex gap-2 mb-8">
            <div class="w-2.5 h-2.5 rounded-full bg-[#CD1C18]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#FFA896]"></div>
        </div>

        <div class="font-mono text-[11px] leading-relaxed text-[#38000A]/60">
            <p class="mb-2">> SOURCE: Nitish_Thotakura</p>
            <p class="mb-6">> ACTION: INITIALIZE_COMMUNICATION_PROTOCOL</p>
            
            <form action="https://formspree.io/f/your-id" method="POST" class="space-y-6">
                <div class="flex flex-col gap-2">
                    <label class="text-[#CD1C18] uppercase tracking-widest font-bold text-[9px]">--identity</label>
                    <input type="email" name="email" placeholder="your@email.com" required 
                        class="bg-transparent border-b border-[#38000A]/10 py-2 focus:outline-none focus:border-[#CD1C18] transition-colors text-[#38000A] placeholder-[#38000A]/20" />
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[#CD1C18] uppercase tracking-widest font-bold text-[9px]">--message</label>
                    <textarea name="message" rows="3" placeholder="Type your transmission here..." required
                        class="bg-transparent border-b border-[#38000A]/10 py-2 focus:outline-none focus:border-[#CD1C18] transition-colors text-[#38000A] resize-none placeholder-[#38000A]/20"></textarea>
                </div>

                <button type="submit" class="group/btn flex items-center gap-4 mt-4 text-[#CD1C18] font-black uppercase tracking-[0.3em] hover:tracking-[0.4em] transition-all">
                    <span>EXECUTE_SEND</span>
                    <span class="group-hover/btn:translate-x-2 transition-transform">>></span>
                </button>
            </form>
        </div>
    </div>
</div>
<script>
    const form = document.querySelector('form');
    const terminalContent = document.querySelector('.font-mono');

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form as HTMLFormElement);
        
        const btn = form.querySelector('button');
        if (btn) btn.innerText = '>> ENCRYPTING_TRANSMISSION...';

        // 1. Create a timeout so it doesn't hang forever
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 5000); // 5 second limit

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'Accept': 'application/json' },
                signal: controller.signal // 2. Attach the timeout signal
            });

            clearTimeout(timeoutId);

            if (response.ok) {
                if (terminalContent) {
                    terminalContent.innerHTML = `
                        <p class="mb-2">> SOURCE: Nitish_Thotakura</p>
                        <p class="mb-6">> ACTION: COMMUNICATION_PROTOCOL</p>
                        <div class="text-[#CD1C18] animate-pulse">
                            <p class="mb-2">> STATUS: SUCCESS</p>
                            <p class="mb-2">> TRANSMISSION_SENT_SUCCESSFULLY</p>
                            <p>> DISCONNECTING_SECURE_LINE...</p>
                        </div>
                    `;
                }
            } else {
                throw new Error('Server returned an error');
            }
        } catch (error) {
            // 3. This will trigger now since there is no backend
            if (btn) {
                btn.innerText = '>> ERROR: SYSTEM_OFFLINE_RETRY';
                btn.classList.add('text-red-500'); // Optional visual cue
            }
            console.error("Transmission failed:", error);
        }
    });
</script>